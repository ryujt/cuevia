# Enter the key for OpenAI speech transcription. Store the actual key only in .env.
OPENAI_API_KEY=
# The default whisper-1 provides segment timestamps. The GPT transcription models use one interval for the entire recording.
# A key and model saved in the app's Settings take precedence over these values.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Cuevia server configuration.
# Process environment values take precedence over this file, including empty values.
CUEVIA_ADDR=127.0.0.1:8742

# Values containing spaces or # must be quoted. No shell expansion is performed.
# To select another config file, set CUEVIA_ENV_FILE in the process environment:
# CUEVIA_ENV_FILE="/path/to/project config/.env" ./dist/Cuevia.app/Contents/MacOS/Cuevia
